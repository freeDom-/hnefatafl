[Unit]
Description=Hnefatafl remote training worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=hnefatafl-worker
Group=hnefatafl-worker
WorkingDirectory=/opt/hnefatafl
EnvironmentFile=/etc/hnefatafl/worker.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=XDG_CACHE_HOME=/var/lib/hnefatafl-worker/cache
ExecStart=/opt/hnefatafl/.venv/bin/python -m hnefatafl.cli worker --server ${HNEFATAFL_WORKER_SERVER} --work-dir /var/lib/hnefatafl-worker --concurrency 2
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hnefatafl-worker

[Install]
WantedBy=multi-user.target
