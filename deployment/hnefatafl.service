[Unit]
Description=Hnefatafl game and training management
After=network.target

[Service]
Type=simple
User=hnefatafl
Group=hnefatafl
WorkingDirectory=/opt/hnefatafl
Environment=HNEFATAFL_DATA_DIR=/var/lib/hnefatafl
Environment=OMP_NUM_THREADS=2
ExecStart=/opt/hnefatafl/.venv/bin/python -m uvicorn hnefatafl.server:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
StateDirectory=hnefatafl
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hnefatafl
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
