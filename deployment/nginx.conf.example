# Merge this location into your EXISTING HTTPS virtual host. TLS terminates there.
# Restrict LXC ingress to your proxy; set its IP in HNEFATAFL_TRUSTED_PROXIES.
location / {
    proxy_pass http://LXC_IP:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 310s;
    client_max_body_size 132m;
    # No WebSocket/SSE routes currently exist.
}
