# Export these variables in your shell or service environment before startup.
# The application does not automatically load .env files.
HNEFATAFL_DATA_DIR=./data
HNEFATAFL_HOST=127.0.0.1
HNEFATAFL_PORT=8000
# Production requires all three settings below and an initial local admin account.
# HNEFATAFL_ENV=production
# HNEFATAFL_PUBLIC_URL=https://tafl.example.org
# HNEFATAFL_ALLOWED_HOSTS=tafl.example.org,127.0.0.1
# HNEFATAFL_TRUSTED_PROXIES=10.0.0.2
# HNEFATAFL_SESSION_SECONDS=43200
