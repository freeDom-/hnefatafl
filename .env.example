# Export these variables in your shell or service environment before startup.
# The application does not automatically load .env files.
HNEFATAFL_DATA_DIR=./data
HNEFATAFL_HOST=127.0.0.1
HNEFATAFL_PORT=8000
# Production requires all three settings below and an initial local admin account.
# HNEFATAFL_ENV=production
# HNEFATAFL_PUBLIC_URL=https://tafl.example.org
# HNEFATAFL_ALLOWED_HOSTS=tafl.example.org,127.0.0.1
# HNEFATAFL_TRUSTED_PROXIES=10.0.0.2
# HNEFATAFL_SESSION_SECONDS=43200

# Registration is off by default. See docs/REGISTRATION.md before enabling.
HNEFATAFL_REGISTRATION_ENABLED=false
# HNEFATAFL_ACCOUNT_SENDER=noreply@tafl.example.org
# HNEFATAFL_ACCOUNT_SMTP_HOST=smtp.example.org
# HNEFATAFL_ACCOUNT_SMTP_PORT=587
# HNEFATAFL_ACCOUNT_SMTP_TLS=starttls
# Supply HNEFATAFL_ACCOUNT_SMTP_USERNAME and HNEFATAFL_ACCOUNT_SMTP_PASSWORD
# together through protected configuration, never Git or command arguments.
# HNEFATAFL_ACCOUNT_TIMEOUT=10
# HNEFATAFL_ACCOUNT_MAX_ATTEMPTS=4
# HNEFATAFL_ACCOUNT_RETRY_SECONDS=60
# HNEFATAFL_ACCOUNT_LEASE_SECONDS=60
# HNEFATAFL_ACCOUNT_POLL_SECONDS=5
# HNEFATAFL_ACCOUNT_QUEUE_LIMIT=1000
# HNEFATAFL_ACCOUNT_WINDOW_SECONDS=900
# HNEFATAFL_ACCOUNT_REGISTER_IP=5
# HNEFATAFL_ACCOUNT_REGISTER_IDENTITY=3
# HNEFATAFL_ACCOUNT_RESEND_IP=5
# HNEFATAFL_ACCOUNT_RESEND_IDENTITY=3
# HNEFATAFL_ACCOUNT_RESET_IP=5
# HNEFATAFL_ACCOUNT_RESET_IDENTITY=3
# HNEFATAFL_ACCOUNT_CONFIRM_IP=20
# HNEFATAFL_ACCOUNT_CONFIRM_IDENTITY=10
# HNEFATAFL_ACCOUNT_GLOBAL_REQUESTS=600
# HNEFATAFL_ACCOUNT_GLOBAL_HASHES=100
# HNEFATAFL_ACCOUNT_GLOBAL_MAIL=100
# HNEFATAFL_ACCOUNT_LIMIT_KEYS=10000

# Backend online admission stays off until separately enabled. See docs/ONLINE.md.
HNEFATAFL_ONLINE_ENABLED=false
# Automatic timeout losses are enabled. Set false to pause them during an incident.
HNEFATAFL_ONLINE_TIMEOUT_POLICY_APPROVED=true
# HNEFATAFL_ONLINE_SWEEP_SECONDS=1
# HNEFATAFL_ONLINE_SWEEP_BATCH=50
# Per-account limits; a two-game match counts as one creation.
# HNEFATAFL_ONLINE_WAITING_LIMIT=5
# HNEFATAFL_ONLINE_CREATION_LIMIT=10
# HNEFATAFL_ONLINE_CREATION_WINDOW_SECONDS=900
